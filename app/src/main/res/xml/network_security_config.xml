<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext disabled app-wide. Debug builds may pin less strictly via OkHttp. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
